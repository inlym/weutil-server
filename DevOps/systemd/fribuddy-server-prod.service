# fribuddy-server-prod.service
#
# 服务端生产环境 systemd 服务配置文件
#
# 使用说明：
# 1. 复制文件到系统目录：sudo cp fribuddy-server-prod.service /etc/systemd/system/
# 2. 重新加载 systemd 配置：sudo systemctl daemon-reload
# 3. 设置开机自启动：sudo systemctl enable fribuddy-server-prod.service
# 4. 启动服务：sudo systemctl start fribuddy-server-prod.service
# 5. 查看服务状态：sudo systemctl status fribuddy-server-prod.service
# 6. 查看服务日志：sudo journalctl -u fribuddy-server-prod.service -f
# 7. 停止服务：sudo systemctl stop fribuddy-server-prod.service
# 8. 禁用开机自启动：sudo systemctl disable fribuddy-server-prod.service
#
# 注意事项：
# - 确保 Java 应用已构建完成：mvn clean package -DskipTests=true
# - 确保工作目录 /opt/fribuddy-server 存在且有正确权限
# - 确保 jar 文件直接上传到 /opt/fribuddy-server/fribuddy-server.jar


[Unit]
# 服务描述
Description=Fribuddy Server Prod
# 依赖服务：在网络服务和多用户服务启动后启动
After=network.target multi-user.target
# 强制依赖网络服务
Requires=network.target
# 限制失败重启次数：3次
StartLimitBurst=3
# 300秒内最多3次重启
StartLimitIntervalSec=300

[Service]
# 服务类型：简单进程
Type=simple
# 工作目录：Java 应用的根目录
WorkingDirectory=/opt/fribuddy-server
# 启动命令：使用 Java 运行 Spring Boot 应用，指定生产环境配置
ExecStart=/usr/bin/java $JAVA_OPTS \
    -jar fribuddy-server.jar --spring.profiles.active=prod
# 失败时自动重启
Restart=on-failure
# 重启间隔：5秒
RestartSec=5
# 启动超时时间：120秒
TimeoutStartSec=120
# 停止超时时间：20秒
TimeoutStopSec=20
# 标准输出重定向到系统日志
StandardOutput=journal
# 标准错误重定向到系统日志
StandardError=journal
# 系统日志标识符
SyslogIdentifier=fribuddy-server-prod
# Java 虚拟机参数：适用于 2G 内存服务器，使用 G1 垃圾回收器，无头模式，内存溢出时退出，UTC 时区
Environment="JAVA_OPTS=-Xms512m -Xmx1200m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Djava.awt.headless=true -XX:+ExitOnOutOfMemoryError -Duser.timezone=UTC"
# Spring 环境配置：生产环境
Environment="SPRING_PROFILES_ACTIVE=prod"
# 自动创建 /var/log/fribuddy-server 目录并设置正确权限
LogsDirectory=fribuddy-server

[Install]
# 安装目标：多用户环境启动时自动启动
WantedBy=multi-user.target
