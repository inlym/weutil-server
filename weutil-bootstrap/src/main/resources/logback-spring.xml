<?xml version="1.0" encoding="UTF-8"?>
<!--
  weutil Server Logback 配置文件

  功能特性：
  - 支持控制台和文件日志输出
  - 分布式链路追踪 trace ID 集成
  - 异步日志写入提升性能
  - 日志文件自动滚动和清理
  - JSON 格式日志输出，便于日志分析和处理
  - 不同环境的日志级别配置

  文档地址：https://logback.qos.ch/manual/configuration.html
-->
<configuration scan="true" scanPeriod="60 seconds">

    <!-- ==================== 配置变量定义 ==================== -->

    <!-- 使用 Spring Boot 扩展标签获取 application.yml 中的配置 -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name"/>
    <springProperty scope="context" name="APP_LOG_LEVEL" source="logging.level.com.weutil" defaultValue="INFO"/>

    <!-- 日志文件存储目录，默认指向 Linux 生产环境路径，本地开发通过 application-local.yml 覆盖 -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="/var/log/weutil-server"/>

    <!-- ==================== 控制台彩色日志配置 ==================== -->

    <!-- 彩色日志转换规则定义 -->
    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex"
                    class="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx"
                    class="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

    <!--
      控制台彩色日志格式
      时间戳(淡色) 日志级别 进程ID(洋红色) - [线程名](淡色) [trace ID](黄色) Logger名称(青色) : 消息
      各部分使用不同颜色便于快速识别
    -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr([%X{TRACE_ID:-}]){yellow} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <!-- ==================== Appender 配置 ==================== -->

    <!--
      控制台日志输出 Appender
      开发环境下实时查看日志信息，使用彩色格式便于快速识别不同级别的日志
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!-- 使用彩色日志格式 -->
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <!-- 设置字符编码为 UTF-8 -->
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      主日志文件 Appender (同步)
      记录 INFO 及以上级别的日志（含 ERROR，错误日志同样写入本文件）
      滚动策略：单个文件最大 5MB，保留 30 天历史，总大小限制 1GB
      使用 JSON 格式输出，便于日志分析和处理
    -->
    <appender name="FILE_SYNC" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前日志文件路径，文件名为应用名称（取自 spring.application.name） -->
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <!-- 文件滚动策略：按日期和大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 滚动文件命名格式：{应用名}.2024-01-01.0.log -->
            <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 单个文件最大大小 -->
            <maxFileSize>5MB</maxFileSize>
            <!-- 保留历史文件天数 -->
            <maxHistory>30</maxHistory>
            <!-- 所有文件总大小限制 -->
            <totalSizeCap>1GB</totalSizeCap>
            <!-- 启动时清理过期文件 -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <!-- 使用自定义 JSON 格式化器，去掉 APP_NAME 和 LOG_LEVEL 字段，将 deviceId 和 traceId 提升到顶级 -->
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <!-- 时间戳字段 -->
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <pattern>yyyy-MM-dd HH:mm:ss.SSS</pattern>
                </timestamp>
                <!-- 日志级别字段 -->
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <!-- 线程名字段 -->
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <!-- Logger 名称字段 -->
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <!-- 消息字段 -->
                <message/>
                <!-- MDC 字段：只提取 traceId、clientIp 到顶级 -->
                <mdc>
                    <includeMdcKeyName>TRACE_ID</includeMdcKeyName>
                    <includeMdcKeyName>CLIENT_IP</includeMdcKeyName>
                </mdc>
                <!-- 异常堆栈字段 -->
                <stackTrace>
                    <fieldName>stackTrace</fieldName>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <!-- ==================== 异步 Appender 配置 ==================== -->

    <!--
      主日志文件异步 Appender
      通过异步写入提升日志记录性能，避免阻塞业务线程
    -->
    <appender name="FILE" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 队列大小 512，平衡内存使用和性能 -->
        <queueSize>512</queueSize>
        <!-- 不丢弃任何日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 不包含调用者信息，提升性能 -->
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="FILE_SYNC"/>
    </appender>

    <!-- ==================== 应用程序 Logger 配置 ==================== -->

    <!--
      weutil 应用程序日志配置
      com.weutil 包的日志级别由各环境的 application-*.yml 中 logging.level.com.weutil 控制
    -->
    <logger name="com.weutil" level="${APP_LOG_LEVEL}" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- ==================== 根 Logger 配置 ==================== -->

    <!--
      根日志配置
      固定 INFO 级别，控制第三方库日志输出
    -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
